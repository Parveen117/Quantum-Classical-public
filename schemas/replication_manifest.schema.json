{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Parveen117/Quantum-Classical/schemas/replication_manifest.schema.json",
  "title": "Multi-Ledger Operator-Memory Replication Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark_version", "files"],
  "properties": {
    "schema": {"const": "MULTI_LEDGER_OPERATOR_MEMORY_REPLICATION_MANIFEST_V1"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {"pattern": "^[^/\\\\]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
