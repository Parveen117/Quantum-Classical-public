{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Parveen117/Quantum-Classical/schemas/replication_certificate.schema.json",
  "title": "Multi-Ledger Operator-Memory Replication Certificate",
  "type": "object",
  "required": ["schema", "benchmark_version", "created_at_utc", "classification", "run_count", "passing_run_count", "backend_count", "duplicate_job_ids", "duplicate_result_hashes", "cross_run_stability", "runs", "scientific_boundary"],
  "properties": {
    "schema": {"const": "MULTI_LEDGER_OPERATOR_MEMORY_REPLICATION_CERTIFICATE_V1"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "classification": {"enum": ["NO_HARDWARE_EVIDENCE", "NO_REPRODUCIBLE_MULTI_LEDGER_MEMORY", "MIXED_REPLICATION_RESULT", "SINGLE_HARDWARE_RUN_ONLY", "REPLICATION_UNSTABLE", "SAME_BACKEND_REPLICATION", "CROSS_BACKEND_REPLICATION", "EVIDENCE_DUPLICATION_DETECTED"]},
    "run_count": {"type": "integer", "minimum": 0},
    "passing_run_count": {"type": "integer", "minimum": 0},
    "backend_count": {"type": "integer", "minimum": 0},
    "duplicate_job_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "duplicate_result_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "cross_run_stability": {"type": "object", "required": ["pass", "gates", "statistics"]},
    "runs": {"type": "array", "items": {"type": "object"}},
    "scientific_boundary": {"type": "string", "minLength": 20}
  }
}
